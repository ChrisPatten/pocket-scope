[Unit]
Description=PocketScope live view (TFT) for user %i
Wants=network-online.target
After=network-online.target
StartLimitBurst=10
StartLimitIntervalSec=60

[Service]
Type=simple
# instance name (eg. pocketscope) is available as %i; user's home is %h
User=%i
# Note: WorkingDirectory removed to avoid permission issues with %h expansion
# The Python script will use its own working directory resolution
# Load environment file from /etc/default/pocketscope if present, otherwise
# fall back to the user's environment (systemd will not expand $HOME in
# EnvironmentFile, so prefer /etc/default for system-wide installs). Keep the
# leading '-' to ignore missing files.
EnvironmentFile=-/etc/default/pocketscope
# Ensure Python output is unbuffered for logs
Environment=PYTHONUNBUFFERED=1

# ExecStart: Use absolute path wrapped in shell to expand environment variables with defaults
# Replace /home/pocketscope with actual user home if different
ExecStart=/bin/sh -c 'exec /home/pocketscope/pocket-scope/.venv/bin/python -m pocketscope --file "${POCKETSCOPE_LOCAL_SOURCE}" --center "${POCKETSCOPE_CENTER}" --tft --enable-gps --gps-port "${POCKETSCOPE_GPS_PORT:-/dev/serial0}" --gps-baudrate "${POCKETSCOPE_GPS_BAUDRATE:-9600}"'

KillSignal=SIGINT
TimeoutStopSec=15
Restart=always
RestartSec=3

# Uncomment if you need additional device access:
# SupplementaryGroups=gpio,spi,video

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
