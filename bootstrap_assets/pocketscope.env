POCKETSCOPE_URL="https://adsb.chrispatten.dev/data/aircraft.json"
POCKETSCOPE_CENTER="42.00748,-71.20899"
# Use the invoking user's home directory so the file is deployable for any
# username. Consumers should source this file (shell) or let systemd load it
# (EnvironmentFile) — in either case `$HOME` will expand correctly for that
# user.
POCKETSCOPE_HOME="${HOME}/.pocketscope"
POCKETSCOPE_RUNWAYS_SQLITE="${POCKETSCOPE_HOME}/runways.sqlite"